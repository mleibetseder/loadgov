# /etc/loadgov/loadgov.toml: optional. A missing file means the built-in defaults shown here.
# Everything specific to your site (projects, addresses, lock names, log paths) is set here, never in code;
# see README.md "Configure for your site".
# Only the four profiles below exist; a table overrides just the keys it names.
# Ranges: max_cores 1.0-6.0 step 0.5, target_cpu_pct 35-90 step 5, load_max 1.0-6.0 step 0.5,
# max_implementers 0-4, max_reviewers 0-8, max_light 0-8, ram_floor_gb 2.0-6.0 step 0.5.

default_profile = "balanced"

[governor]
# false: shadow, log WOULD cap=... audit lines only; true: write cpu.max of build-work.slice (and every
# mirror_cgroups entry of [compat]). The last cap stays when the daemon stops; it is never set to max.
enforce = false

[memguard]
# false: shadow, log WOULD PAUSE|RESUME|ABORT|REAP audit lines only; true: freeze/SIGSTOP/docker pause
# work, SIGTERM the largest rustc and the JVM build daemons (docs/protocol.md "Memory guard").
# Paused work stays paused if the daemon dies; `loadgovd --recover --force` thaws it.
enforce = false
# pre_gate_reap_gb = 8      # built-in default, stays. Acts only with enforce = true, only for `loadctl run --kind
#                           # gate`, only below this much MemAvailable, only on IDLE Gradle/Kotlin daemons (outside
#                           # every job scope). 0 = off; set it if a gate loses a warm daemon it needed
# log_path = "/var/log/loadgov/memguard.log"   # legacy memory-guard log style lines
# Early pressure of the global rule (docs/protocol.md "Memory guard", Thresholds and Deficit cover):
# swap_free_min_mb = 1024   # built-in default: pressure when free swap (SwapTotal - used) is below this while
#                           # MemAvailable is below the resume level. 0 = off; no effect on a host without swap
# horizon_samples = 2       # built-in default: pressure when MemAvailable - (fall since the last sample) * this
#                           # is below LOW. 0 = off. A fall of 512 MB or more per sample also pauses several
#                           # trees in one sample until they cover the deficit, without the 15 s quiet
# Containers that are never docker-paused, whatever a project's regex says (fnmatch globs):
# deny_containers = ["*-test-db*", "*-review-*"]   # the default
# Implementer trees of a legacy dispatcher: a `bash <prefix>*` whose snapshot file has a line starting with
# `marker`; the trees are reported under `project`. Off unless set.
# legacy_snapshot = { prefix = "/tmp/dispatcher-snap.", marker = "# Usage: dispatch.sh", project = "example-project" }
# A host-wide pause file under /run/lock, present while that project has work paused (read by `loadctl wait`).
# pause_marker = { file = "example-guard.paused", project = "example-project" }
# Per-project rule instead of the global one (LOW = the RAM floor, RESUME = max(6 GB, floor + 2 GB)).
# There are no built-in projects:
# [memguard.projects.example-project]
# low_mb = 2048
# high_mb = 4096
# swap_mb = 2048
# resume_samples = 12
# containers = '^(gates-[0-9]|review-)'
# agent_cwd = "/srv/work/example-project"   # or a list: ["/srv/work/example-project", "/srv/work/example-project-wt"]

[backstop]
# Hard kernel limit under build-work.slice (docs/protocol.md "Memory backstop"). OFF, and NO built-in
# values: enabled = true without both numbers below is a config error. Fill them from the trial-run history:
#   loadctl history --all --csv | python3 tools/backstop_sizing.py -      (after a week of history, see docs/deployment.md)
# and state the source next to the numbers, for example:
#   # source: backstop_sizing.py over one week of history, peak build-work memory.current 10240 MB, +20 %
# memory_max_mb must be >= 4096; memory_swap_max_mb >= 0. With enabled = true the daemon also sets
# memory.oom.group = 1 on every `loadctl run` job scope, so an OOM kill takes that one scope down as a group.
# The daemon applies the numbers with `systemctl set-property --runtime build-work.slice MemoryMax=… MemorySwapMax=…`
# (starting the slice first when it is inactive after boot) and checks the cgroup files: systemd overwrites a value
# written only to the file whenever it re-realizes the slice. Usage already at or above memory_max_mb: the limit
# starts as a cap at usage + cap_margin_mb and steps down to memory_max_mb as usage falls (one warning alert).
# Rollback: remove this table (or enabled = false) and restart; the daemon sets MemoryMax=infinity
# MemorySwapMax=infinity and writes `max` back (the only case).
enabled = false
# memory_max_mb = 12288
# memory_swap_max_mb = 2048
# cap_margin_mb = 512       # built-in default
# Per-project caps (OFF: 0). With enabled = true, every build-work-<project>.slice gets
#   systemctl set-property --runtime build-work-<project>.slice MemoryMax=<cap>M MemoryHigh=<high>M
# so a runaway is throttled, then confined to its own slice instead of making the kernel kill other projects'
# jobs. 1024 <= cap <= memory_max_mb. Override per project with `memory_max_mb` in [projects.<name>]
# (0 = no cap for that project). A nested name (a-b) also sits under its parent's (a) slice and cap.
# project_memory_max_mb = 0       # built-in default: off
# project_memory_high_pct = 90    # MemoryHigh as % of the cap (50..100)
# Read-only, also with enabled = false: tmpfs files (/tmp) a job wrote stay charged to its slice after it
# ends, and a SIGKILL skips the job's own cleanup. A slice holding more than leak_alert_mb of shmem (file
# cache is reclaimable and does not count) with no process for leak_alert_min minutes raises one
# `backstop_leak` warning; tmpfs directories of at
# least leftover_report_mb are named with the jobs that likely wrote them. Nothing is ever deleted.
# leak_alert_mb = 1024
# leak_alert_min = 5
# leftover_report_mb = 1024

[strays]
# Stray-process guard (docs/protocol.md "Stray guard"): finds orphaned CPU hogs (the agent that started them
# is gone) that run outside every job scope, service and container. `enabled` only reads /proc; nothing is
# ever signalled automatically. `enforce = true` lets the OWNER kill (loadctl stray --kill PID --owner,
# POST /v1/stray/kill, the phone button) send SIGTERM, then SIGKILL after 30 s; off = audit WOULD KILL only.
enabled = true
enforce = false
# check_s = 300             # seconds between checks (at least 60)
# min_age_s = 1800          # hot continuously this long before a process counts as a stray
# min_cpu_pct = 50          # percent of one core over the last interval that makes a process "hot"
# Extra cgroups that are never strays (fnmatch globs on the cgroup path); /system.slice, /init.scope and
# docker/containerd/libpod scopes are always excluded:
# exclude_cgroups = ["/user.slice/user-1000.slice/*"]

[reaper]
# false: only log WOULD REAP; true: thaw and terminate paused trees whose agent session is gone.
enforce = false

[slots]
# false: arbitrate among loadgov clients only and log WOULD flock events; true: take the real
# /run/lock flock files and write the holder lines so legacy scripts see loadgov holders.
enforce = false
# The compile slot's lock file under /run/lock (default host-compile-slot.lock). The environment variable
# LOADGOV_COMPILE_LOCK sets the same when this key is absent.
# compile_lock = "host-compile-slot.lock"

# Thresholds of the `disk` alert (busy = warning, limit = critical) and of `levels.disk_alert`. A number is GB free,
# a string "NN%" is percent used of the filesystem (above 0, below 100). Defaults: 25 and 10 GB free.
# Each value is checked on its own (units may be mixed) against every watched path; the worst path wins.
# Applied on reload. They never change the overall `level` (`levels.disk` keeps the fixed 25/10 GB free rule), so
# nothing is refused or delayed because of disk: no gate, compile or `--headroom level` start waits on it.
# [levels]
# disk_busy = "80%"
# disk_limit = 10

[host]
# The host id: it names this host in the status (host.id), every audit line and every alert, so a fleet view
# can tell hosts apart. Optional: the default is the hostname, lowercased, reduced to a-z 0-9 - (at most
# 63 characters), kept in state.json after the first start. A value here wins over the saved id and is
# audited once as host_id_changed. Restart the daemon to change it.
# id = "build-a"
# mode = "govern"   # "monitor": every enforce flag is forced off at run time (WOULD decisions only);
#                   # a reload may switch it and is audited as host_mode_changed

# The fleet: the OTHER hosts this daemon collects (read-only; docs/protocol.md, Fleet). Empty = this host only.
# Each daemon still decides only for its own host. token_env names a variable in /etc/loadgov/tokens.env
# that holds that host's REST bearer token; never put a token here. Live on reload.
# [[fleet]]
# id = "build-b"                       # a-z 0-9 -, the id that host reports as [host] id
# url = "http://192.0.2.20:7420"       # that host's REST surface
# token_env = "LOADGOV_TOKEN_BUILD_B"
# mode = "monitor"                     # "monitor" (only watched) or "govern"

[keys]
# Link template for the issue key of a queue item or job (`loadctl run --key`, LOADGOV_KEY). It must
# contain {key}; the status field `url` is this with {key} replaced by the URL-quoted key. Empty: no links.
# url = "https://tracker.example/issues/{key}"

[profiles.silent]
max_cores = 2.0
target_cpu_pct = 50
load_max = 2.0
max_implementers = 1
max_reviewers = 1
max_light = 2
cargo_build_jobs = 1

[profiles.balanced]
max_cores = 3.5
target_cpu_pct = 65
load_max = 3.0
max_implementers = 2
max_reviewers = 3
max_light = 4
cargo_build_jobs = 2
# Per profile, with these defaults when omitted:
# load_hold = 5.0          # its own key, never derived from load_max
# impl_max_quiet = 2       # defaults to max_implementers
# ram_floor_gb = 3.0
# vitest_max_workers = 2
# gate_shard_budget = 2

[profiles.boost]
max_cores = 5.5
target_cpu_pct = 85
load_max = 5.0
max_implementers = 3
max_reviewers = 4
max_light = 6
cargo_build_jobs = 3

[profiles.drain]
max_cores = 2.0
target_cpu_pct = 50
load_max = 2.0
max_implementers = 0
max_reviewers = 0
max_light = 0
cargo_build_jobs = 1
hold_heavy_slot = true   # stored only; the hold itself is taken through the slots

# ---- Headroom (loadctl wait) -------------------------------------------------------------------
# Defaults are the stricter values below for every kind (impl, review, gate, compile, light).
# load1_max / load5_max may be numbers or "nproc" expressions ("nproc", "nproc-2", "nproc*0.5"),
# resolved against the host's core count when a decision is made (a result <= 0 makes every decision
# fail with a "misconfigured" reason); load5_max = false disables it. max_wait_s = 0 waits forever.
# Kind `review` uses the review lane: only mem_min_gb (default 2 for reviews) and the profile's
# max_reviewers apply; load1_max, load5_max, psi_max, swap_max_mb, swap_in_max and mem_psi_max are ignored for it.
# Kind `light` (see [light] below) works the same way with the profile's max_light.
# Load thresholds scale with the active profile (load_max / default profile's load_max) and
# mem_min_gb rises by the profile's ram_floor_gb above the default profile's.
[headroom]
io_psi_gate = false      # io PSI some avg60 < 25 blocks only when true; otherwise only recorded (would_block_io)
# io_psi_max = 25
# CPU PSI counts as contention only while the CPU is busy: below this busy % the effective CPU PSI is 0, because a
# throttled cgroup (docker --cpus, loadgov's own cap) raises PSI on idle cores. 0 = always use the raw value.
# psi_busy_gate_pct = 80

# Defaults for every project, per kind (all keys optional):
# [headroom.kinds.impl]
# load1_max = "nproc-2"
# load5_max = "nproc-1.5"
# psi_max = 20
# mem_min_gb = 4
# swap_max_mb = 1024
# swap_in_max = 50        # pages/s swapped in (avg of ~60 s, ~200 KB/s): swap blocks only above both limits
# mem_psi_max = 5
# confirm_s = 60
# poll_s = 30
# max_wait_s = 7200       # 0 = wait forever

# Per-project overrides (there are no built-in projects). The memory cap of the project's slice (see
# project_memory_max_mb under backstop; 0 = no cap for this project):
# [projects.example-project]
# memory_max_mb = 6144
# A project that waits like a legacy script (every 120 s, forever) and has looser limits:
# [projects.example-project.kinds.impl]
# load1_max = 6
# load5_max = false
# psi_max = 50
# mem_min_gb = 6
# poll_s = 120
# max_wait_s = 0
# [projects.example-project.kinds.gate]
# load1_max = "nproc"
# load5_max = false
# psi_max = 50
# mem_min_gb = 4
# poll_s = 120
# max_wait_s = 0

# REST control surface for Home Assistant (docs/protocol.md "REST"). Off by default.
# `bind` has no default and is required when enabled: the host's own LAN address; 0.0.0.0, :: and
# loopback addresses are refused.
# The token lives in /etc/loadgov/tokens.env (see tokens.env.example).
# [rest]
# enabled = false
# bind = "192.0.2.10"
# port = 7420
# allow = []              # source IPs or CIDRs; empty = token only. Add the HA VM IP here later.
# rate_per_s = 5
# max_connections = 16    # 1-64; extra connections are closed unread; one source IP may hold half of them
# allow_private_bridge = false  # a bind in 172.16.0.0/12 (docker bridges) is refused unless this is true

# The per-host web UI (docs/protocol.md "Web UI"): the built Angular app plus read-only JSON, on its own
# listener, no token. Put a reverse proxy with sign-in in front and list ONLY its address in allow.
# [ui]
# enabled = false
# bind = "192.0.2.10"           # the host's own LAN address (same rules as [rest] bind)
# port = 7421
# allow = ["192.0.2.30"]        # the sign-in proxy; required, never a /0 network
# dir = "/opt/loadgov/ui"       # the built app (index.html at the top); see ui/README.md
# tempo_url = "https://tempo.example"   # the "Fleet view: in tempo" link; unset hides it
# runs_dir = "/var/lib/loadgov/runs"    # workflow run records (default: the client default)
# rate_per_s = 20
# max_connections = 16          # 1-64; the proxy is the only client and gets half of them
# allow_private_bridge = false  # a bind in 172.16.0.0/12 (docker bridges) is refused unless this is true

# Push alerts to a Home Assistant webhook (docs/protocol.md "Alerts"). Off by default.
# The webhook id is LOADGOV_HA_WEBHOOK_ID in /etc/loadgov/tokens.env, never here.
# [ha]
# enabled = false
# url = "http://homeassistant.local:8123"   # http:// or https://, no credentials

# Keep legacy log files alive after the legacy loops stop (optional).
# [compat]
# alert_log_paths = []     # e.g. ["/var/log/loadgov/host-alerts.log"]
# mirror_cgroups = []      # cgroups below the cgroup root that follow the governor's cap, e.g. ["legacy-loop"]
# governor_log_path = "/var/log/loadgov/governor.log"  # legacy governor log lines

# Owner claims (--owner) are always refused from inside build-work* cgroups. Add the cgroups and the ancestor
# command lines (regexes) of your own dispatchers here; both lists are empty by default.
# [principal]
# deny_cgroups = ["/legacy-loop"]
# ancestor_deny = ['dispatch-[^/ ]*\.sh', 'queue\.sh']

# Size rotation of the daemon's own audit log (<log-dir>/audit.jsonl). Rotated files are audit.jsonl.1 (newest)
# .. audit.jsonl.<keep> (oldest). max_mb = 0 turns rotation off. Applied on reload.
# [audit]
# max_mb = 50
# keep = 5

# ---- Image train (loadctl image submit / runner) -----------------------------------------------
# Beta and release container builds queue during the day and run in a night window, one at a time (kind
# `image`, heavy slot like a gate). A project's beta runs at most once per beta_interval_h; otherwise only
# when the owner says `loadctl image now ID --owner --reason ...`. The daemon only arbitrates; the runner
# (loadgov-image-runner.timer) runs the jobs. Uncomment to change (applied on reload; the owner can override
# window, timezone and beta_interval_h at run time with `loadctl set --image-window ...`, see docs/protocol.md):
# [image]
# window = "00:00-06:00"       # HH:MM-HH:MM wall-clock times of `timezone`; may cross midnight
# timezone = "UTC"             # IANA name, e.g. "America/New_York"
# beta_interval_h = 48         # a project's beta starts at most this often (from its last beta's start)
# max_runtime_min = 90         # past this an image job raises image_overrun:<project> (never killed)
# max_per_night = 6            # image jobs started per window
# env_allow = ["PATH", "HOME", "LANG", "DOCKER_HOST", "DOCKER_CONFIG", "LOADGOV_KEY"]  # kept for a job

# ---- Light lane (loadctl run --kind light) -----------------------------------------------------
# Small read-only checks (lint, shellcheck, formatters in check mode, link and config checks, small unit
# tests) take no heavy or compile slot. `loadctl run --kind light` puts each under these hard limits on
# the scope it creates; the daemon itself writes nothing. Uncomment to tighten (the ranges cap how loose):
# [light]
# cpu_quota_pct = 100          # CPUQuota of the scope, 10-200
# memory_max_mb = 1024         # MemoryMax of the scope (MemorySwapMax is always 0), 128-4096
# max_runtime_s = 600          # loadctl kills the scope after this long (exit 76, LIGHT_OVERRUN), 30-1800
# max_light_per_project = 2    # registered light jobs of one project, 1-8 (the host-wide cap is the
#                              # profile's max_light)

# ---- Compile memory admission (the compile slot, docs/protocol.md "Slots") ---------------------------
# A compile (loadctl run --kind compile --label <crate>) starts only when MemAvailable is at least the
# crate's expected memory peak plus the memory guard's low floor; until then it waits at the head of the
# compile queue (FIFO, nobody passes it). The peak is learned from finished compiles. Default off.
# [compile]
# memory_admission = false     # true: hold a compile back until it fits
# default_peak_mb = 1024       # expected peak of a crate without history, 64-262144
# history = 20                 # last N peaks per crate the percentile is taken over, 1-50
# percentile = 90              # of those peaks, 50-100 (100 = the maximum)
# max_memory_wait_s = 900      # a compile held back this long is admitted anyway, 10-86400
