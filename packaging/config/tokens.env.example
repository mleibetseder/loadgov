# /etc/loadgov/tokens.env: the REST bearer token (mode 0600, owner root; loadgovd refuses anything looser).
# Generate one (32 random bytes, 43 characters) and keep it out of git:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Home Assistant sends it as `Authorization: Bearer <token>` (secret `loadgov_token`).
LOADGOV_REST_TOKEN=replace-with-the-generated-token
# Home Assistant webhook id for alert pushes ([ha] enabled = true): the part after /api/webhook/ in the
# webhook trigger of the HA automation. Letters, digits, _ and - only. Treat it like a password.
# LOADGOV_HA_WEBHOOK_ID=replace-with-the-webhook-id
